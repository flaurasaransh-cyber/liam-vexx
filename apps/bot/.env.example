# Bot token from the Discord Developer Portal (Bot -> Reset Token)
DISCORD_TOKEN=
# Password for the admin panel
ADMIN_PASSWORD=
# Any long random string; signs admin sessions
SESSION_SECRET=
# Where the admin panel is served, comma separated (for CORS)
ADMIN_ORIGIN=http://localhost:5173
# Optional: a private channel for the bot's saved settings. Left empty, the bot creates "vexx-bot-config"
# in the same server as the panel channel, visible only to itself and server admins.
CONFIG_CHANNEL_ID=
PORT=3000
